{
  "title": "Executive Overview",
  "panels": [
    { "type": "stat", "title": "Traffic (5m)", "targets": [{ "expr": "sum(rate(gateway_requests_total[5m]))" }] },
    { "type": "graph", "title": "Requests by Plan", "targets": [{ "expr": "sum by(plan_type)(rate(gateway_requests_total[5m]))" }] },
    { "type": "graph", "title": "Success Rate", "targets": [{ "expr": "1 - (sum(rate(ai_core_error_total[5m]))/sum(rate(ai_core_requests_total[5m])))" }] },
    { "type": "graph", "title": "Latency p95", "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(ai_core_latency_seconds_bucket[5m])) by (le,plan_type))" }] },
    { "type": "graph", "title": "Token Usage (1h)", "targets": [{ "expr": "sum by(plan_type)(increase(ai_core_tokens_total[1h]))" }] },
    { "type": "graph", "title": "Connector Success", "targets": [{ "expr": "sum by(plan_type)(rate(connector_sync_total{status=\"ok\"}[5m]))" }] }
  ]
}


