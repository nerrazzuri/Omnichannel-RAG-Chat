{
  "title": "Connector Health",
  "panels": [
    { "type": "graph", "title": "Sync Success by Plan", "targets": [{ "expr": "sum by(plan_type)(rate(connector_sync_total{status=\"ok\"}[5m]))" }] },
    { "type": "graph", "title": "Sync Failures by Reason", "targets": [{ "expr": "sum by(reason)(rate(connector_sync_total{status=\"error\"}[5m]))" }] },
    { "type": "graph", "title": "Throughput (records)", "targets": [{ "expr": "sum by(tenant_id,connector_id)(rate(connector_records_ingested_total[5m]))" }] },
    { "type": "graph", "title": "Latency", "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(connector_duration_seconds_bucket[5m])) by (le,connector_id))" }] }
  ]
}


