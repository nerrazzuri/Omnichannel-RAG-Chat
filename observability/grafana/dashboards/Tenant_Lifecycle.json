{
  "title": "Tenant Lifecycle",
  "panels": [
    { "type": "stat", "title": "Creates", "targets": [{ "expr": "sum(increase(tenant_create_total[24h]))" }] },
    { "type": "stat", "title": "Activations", "targets": [{ "expr": "sum(increase(tenant_activate_total[24h]))" }] },
    { "type": "graph", "title": "Upgrades by plan", "targets": [{ "expr": "sum by(from,to)(increase(tenant_upgrade_total[1h]))" }] },
    { "type": "graph", "title": "Migrations duration", "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(tenant_migration_duration_seconds_bucket[5m])) by (le,type))" }] },
    { "type": "graph", "title": "Migration failures", "targets": [{ "expr": "sum by(stage,reason)(increase(tenant_migration_failures_total[1h]))" }] }
  ]
}


