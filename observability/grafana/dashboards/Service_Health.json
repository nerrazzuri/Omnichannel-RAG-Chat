{
  "title": "Service Health",
  "panels": [
    { "type": "graph", "title": "AI-Core p95 Latency", "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(ai_core_latency_seconds_bucket[5m])) by (le))" }] },
    { "type": "graph", "title": "AI-Core Error Rate", "targets": [{ "expr": "sum(rate(ai_core_error_total[5m]))/sum(rate(ai_core_requests_total[5m]))" }] },
    { "type": "graph", "title": "Gateway Rate Limit Exceeded", "targets": [{ "expr": "sum(rate(gateway_rate_limit_exceeded_total[5m]))" }] },
    { "type": "stat", "title": "Active Tenants (5m)", "targets": [{ "expr": "count(sum by(tenant_id)(rate(gateway_requests_total[5m])))" }] }
  ]
}


