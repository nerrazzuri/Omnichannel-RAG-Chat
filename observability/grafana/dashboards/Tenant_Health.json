{
  "title": "Tenant Health",
  "panels": [
    { "type": "graph", "title": "Uptime Proxy", "targets": [{ "expr": "1 - (sum by(tenant_id)(rate(ai_core_error_total[5m])) / sum by(tenant_id)(rate(ai_core_requests_total[5m])))" }] },
    { "type": "graph", "title": "Token Usage vs Quota", "targets": [{ "expr": "sum by(tenant_id)(increase(ai_core_tokens_total[1d]))" }] },
    { "type": "graph", "title": "Backup Status", "targets": [{ "expr": "ai_core_backup_job_success" }] },
    { "type": "graph", "title": "Connector Success Rate", "targets": [{ "expr": "1 - (sum by(tenant_id)(rate(connector_sync_failures_total[15m])) / sum by(tenant_id)(rate(connector_sync_total[15m])))" }] }
  ]
}


