{
  "title": "Gateway Overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {"type": "stat", "title": "RPS", "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}, "targets": [{"expr": "rate(gateway_requests_total[5m])"}]},
    {"type": "stat", "title": "p95 Latency (s)", "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0}, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(gateway_request_latency_seconds_bucket[5m])) by (le))"}]},
    {"type": "graph", "title": "5xx Rate", "gridPos": {"h": 7, "w": 12, "x": 0, "y": 6}, "targets": [{"expr": "rate(gateway_requests_total{status=\"500\"}[5m])"}]},
    {"type": "graph", "title": "Rate-limit hits", "gridPos": {"h": 7, "w": 12, "x": 12, "y": 6}, "targets": [{"expr": "increase(gateway_rate_limit_hits_total[1h])"}]}
  ]
}
